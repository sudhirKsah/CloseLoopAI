# CloseAI Cloud Run Job env vars
# Same as closeloop-api.yaml but with CELERY_ALWAYS_EAGER=true
# Copy to closeloop-job.yaml and fill in real values
# DO NOT commit the real .yaml file — it contains secrets
DATABASE_URL: "postgresql+psycopg://USER:PASS@NEON_HOST/neondb?sslmode=require"
REDIS_URL: "rediss://default:PASS@UPSTASH_HOST:6379"
PUBLIC_API_BASE_URL: "https://closeloop-api-XXXX.run.app"
FRONTEND_URL: "https://pathayo.com"
AI_PROVIDER: "gemini"
GEMINI_API_KEY: "YOUR_GEMINI_KEY"
GEMINI_MODEL: "gemini-flash-latest"
OPENAI_API_KEY: "YOUR_OPENAI_KEY"
MEETING_EXTRACTION_MODEL: "gpt-5.6"
CEREBRAS_API_KEY: "YOUR_CEREBRAS_KEY"
CEREBRAS_MODEL: "gpt-oss-120b"
TASK_AUTO_APPROVE_CONFIDENCE: "0.85"
CREDENTIAL_ENCRYPTION_KEY: "YOUR_BASE64_KEY"
JWT_SECRET_KEY: "YOUR_JWT_SECRET"
KGMEMORY_BASE_URL: "https://kgmemory-api-XXXX.run.app/v1"
KGMEMORY_SERVICE_EMAIL: "admin@example.com"
KGMEMORY_SERVICE_PASSWORD: "YOUR_PASSWORD"
CELERY_ALWAYS_EAGER: "true"
RECALL_API_KEY: "YOUR_RECALL_KEY"
RECALL_REGION: "us-west-2"
RECALL_WORKSPACE_VERIFICATION_SECRET: "YOUR_SECRET"
RECALL_SVIX_WEBHOOK_SECRET: "YOUR_SECRET"
JIRA_CLIENT_ID: "YOUR_ID"
JIRA_CLIENT_SECRET: "YOUR_SECRET"
LINEAR_CLIENT_ID: "YOUR_ID"
LINEAR_CLIENT_SECRET: "YOUR_SECRET"
GITHUB_CLIENT_ID: "YOUR_ID"
GITHUB_CLIENT_SECRET: "YOUR_SECRET"
GITHUB_WEBHOOK_SECRET: "YOUR_SECRET"
GOOGLE_CLIENT_ID: ""
GOOGLE_CLIENT_SECRET: ""
MICROSOFT_CLIENT_ID: ""
MICROSOFT_CLIENT_SECRET: ""
CLERK_ISSUER: "YOUR_CLERK_ISSUER"
CLERK_AUDIENCE: ""
CLERK_JWKS_URL: "YOUR_CLERK_JWKS_URL"
CLERK_SECRET_KEY: "YOUR_CLERK_KEY"
SLACK_SIGNING_SECRET: "YOUR_SECRET"
SLACK_CLIENT_ID: "YOUR_ID"
SLACK_CLIENT_SECRET: "YOUR_SECRET"
NOTION_CLIENT_ID: ""
NOTION_CLIENT_SECRET: ""
SMTP_HOST: "smtp.resend.com"
SMTP_PORT: "587"
SMTP_USERNAME: "resend"
SMTP_PASSWORD: "YOUR_RESEND_KEY"
SMTP_FROM: "noreply@mail.pathayo.com"
SUPPORT_INBOX: "support@mail.pathayo.com"
PAYMENT_INBOX: "payment@mail.pathayo.com"
REPORTS_DIR: "./reports"
