# kgmemory API env vars for Cloud Run
# Copy to kgmemory-api.yaml and fill in real values
# DO NOT commit the real .yaml file — it contains secrets
DATABASE_URI: "postgres://USER:PASS@NEON_HOST/neondb?ssl=require"
REDIS_URL: "rediss://default:PASS@UPSTASH_HOST:6379"
FALKORDB_HOST: "VM_EXTERNAL_IP"
FALKORDB_PORT: "6379"
FALKORDB_USERNAME: ""
FALKORDB_PASSWORD: ""
GRAPH_NAME_PREFIX: "org"
ENVIRONMENT: "prod"
DEBUG: "False"
SERVER_HOST: "https://kgmemory-api-XXXX.run.app"
SECRET_KEY: "YOUR_SECRET"
AUTH_TOKEN_LIFETIME_SECONDS: "3600"
BACKEND_CORS_ORIGINS: "[\"http://localhost:8000\",\"http://localhost:3000\"]"
PAGINATION_PER_PAGE: "20"
DEFAULT_FROM_EMAIL: "noreply@mail.pathayo.com"
DEFAULT_FROM_NAME: "CloseLoop"
FIRST_SUPERUSER_EMAIL: "admin@example.com"
FIRST_SUPERUSER_PASSWORD: "YOUR_PASSWORD"
LLM_BASE_URL: "https://api.cerebras.ai/v1"
LLM_API_KEY: "YOUR_CEREBRAS_KEY"
LLM_MODEL: "gpt-oss-120b"
LLM_MAX_TOKENS: "4000"
LLM_TEMPERATURE: "0.1"
LLM_TIMEOUT_SECONDS: "90"
LLM_MAX_RETRIES: "2"
EMBEDDING_BASE_URL: ""
EMBEDDING_API_KEY: ""
EMBEDDING_MODEL: "text-embedding-3-small"
EMBEDDING_DIMENSIONS: "1536"
INGEST_CHUNK_CHARS: "8000"
INGEST_MAX_MESSAGE_CHARS: "200000"
INGEST_MAX_EXTRACT_CONCURRENCY: "4"
INGEST_DEDUP_SIMILARITY: "0.92"
CONTEXT_MAX_FACTS: "20"
CONTEXT_DENSE_TOP_K: "50"
CONTEXT_TRAVERSAL_MAX_HOPS: "3"
CONTEXT_LLM_WEIGHT: "0.7"
CONTEXT_DENSE_WEIGHT: "0.3"
CONTEXT_RECENCY_HALF_LIFE_DAYS: "90"
CONTEXT_MIN_RELEVANCE: "0.25"
RATE_LIMIT_REQUESTS: "120"
RATE_LIMIT_WINDOW_SECONDS: "60"
SES_ACCESS_KEY: ""
SES_SECRET_KEY: ""
SES_REGION: ""
