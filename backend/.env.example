# kgmemory knowledge-graph memory microservice.
# KGMEMORY_BASE_URL points at the kgmemory service (default local dev URL).
# The service account credentials (matching kgmemory's FIRST_SUPERUSER_*) let
# the backend auto-provision a dedicated kgmemory org + API key per workspace,
# so users never have to paste an API key manually.
KGMEMORY_BASE_URL=http://localhost:8001/v1
KGMEMORY_SERVICE_EMAIL=admin@example.com
KGMEMORY_SERVICE_PASSWORD=changethis
